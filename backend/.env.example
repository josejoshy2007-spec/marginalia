# Gemini — free key from https://aistudio.google.com/ ("Get API key")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# used automatically when the main model is overloaded (503); leave empty to disable
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Free-tier tuning (see your real limits at https://aistudio.google.com/rate-limit)
GEMINI_RPM=8                 # requests/minute the API paces itself to (0 = off)
GEMINI_MAX_QUOTA_WAIT=20     # seconds it will wait for a slot / short 429 cooldown
GEMINI_MAX_TOKENS=32768      # output cap incl. thinking; only tokens produced count
RETRIEVAL_K=12               # passages (~800 tokens each) sent per question

# Speech model for Listen "studio audio" (Interactions API)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Local Whisper for lecture recordings (any format, up to WHISPER_MAX_MINUTES)
WHISPER_MODEL=base           # tiny | base | small | medium | large-v3 — bigger = more accurate, slower
WHISPER_LANGUAGE=            # e.g. en; empty = auto-detect
WHISPER_MAX_MINUTES=120

# Leave empty to use the embedded Postgres+pgvector (pgserver). Or e.g.
# DATABASE_URL=postgresql://study:study@localhost:5433/study
DATABASE_URL=

# fastembed (local model, downloads ~130MB once) or hash (offline, lower quality)
EMBEDDER=fastembed

CORS_ORIGINS=http://localhost:3000
