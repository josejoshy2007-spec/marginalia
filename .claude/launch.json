{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "web-local",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:local"],
      "port": 3001
    },
    {
      "name": "static",
      "runtimeExecutable": "backend\\.venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "http.server", "3002", "-d", "frontend/out"],
      "port": 3002
    }
  ]
